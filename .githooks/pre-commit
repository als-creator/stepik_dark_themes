#!/bin/sh
# Не даёт закоммитить неработоспособный юзерскрипт.
#
# Смысл: номер версии попадает к пользователю вместе со скриптом, поэтому
# коммит с нерабочим скриптом — это не « черновик, поправлю позже », а уже
# готовая поломка. Проверка идёт до коммита: node --check (синтаксис),
# метаданные и самодостаточность, а в jsdom переключатель применяет каждую
# тему и проверяется, что CSS собрался и в него не попал мусор.
#
# Обойти: git commit --no-verify (осознанно, для отладки самого скрипта).
set -e

cd "$(git rev-parse --show-toplevel)"

# Проверка нужна только когда менялся сам скрипт: правки README её не требуют.
staged=$(git diff --cached --name-only)
if ! printf '%s\n' "$staged" | grep -qx 'stepik-dark-themes.user.js'; then
  exit 0
fi

# node_modules может быть не установлен — предупреждаем, но не блокируем:
# статическая часть проверки всё равно отработает.
if [ ! -d node_modules/jsdom ]; then
  echo "  Внимание: node_modules/jsdom не установлен — функциональная часть проверки пропущена." >&2
  echo "       npm install — чтобы проверять по-настоящему." >&2
fi

exec node tools/check.mjs